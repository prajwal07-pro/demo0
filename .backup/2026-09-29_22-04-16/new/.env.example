# ─────────────────────────────────────────────────────────────────────────────
# ORCA — Environment Configuration
#
# Copy this file to `.env.local` and fill in the values for your environment.
# `.env.local` is gitignored and takes precedence over `.env`.
#
# Only variables prefixed with `VITE_` are exposed to the browser bundle.
# Never place private credentials here — those belong behind the backend
# proxy at VITE_API_BASE_URL.
# ─────────────────────────────────────────────────────────────────────────────

# ---------- Backend ----------
# Base URL for the ORCA backend proxy. When unset (or empty), every service
# falls back to its "unavailable" contract and the UI shows truthful
# DATA UNAVAILABLE / BACKEND REQUIRED states instead of fake values.
#
# Example: https://api.orca.marine
VITE_API_BASE_URL=

# ---------- Feature flags ----------
# Set to "false" to disable a module entirely. Absent values default to
# enabled. The UI respects these flags but does not fabricate data when a
# module is disabled.
VITE_ENABLE_3D=true
VITE_ENABLE_MAP=true
VITE_ENABLE_AI=true
VITE_ENABLE_SIMULATIONS=true
VITE_ENABLE_GAMES=true

# ---------- Map ----------
# Optional MapLibre style URL. Defaults to the public MapLibre demo style
# (https://demotiles.maplibre.org/style.json) when unset.
VITE_MAP_STYLE_URL=

# Default center as "lat,lng" and zoom as a number. Defaults to
# "15.0,85.0" (Bay of Bengal) and "5" when unset.
VITE_MAP_DEFAULT_CENTER=
VITE_MAP_DEFAULT_ZOOM=

# ---------- Optional client-side keys ----------
# Only set these if the provider policy explicitly permits client-side use.
# In production, prefer proxying through the backend so keys never reach the
# browser bundle.
VITE_MAPBOX_TOKEN=
VITE_MAPTILER_KEY=