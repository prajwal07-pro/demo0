# ==============================================================================
# ORCA — Environment Variables
# ==============================================================================
# Copy this file to `.env.local` and fill in your values.
#
# SECURITY NOTE:
#   Never commit `.env.local` or any file containing real credentials.
#   Only public-safe values (those prefixed VITE_) are exposed to the browser.
#   Private API keys MUST live on a backend proxy, never in this file.
# ==============================================================================

# ---------- Backend / API Proxy ----------
# Base URL of the ORCA backend that proxies all marine data providers.
# Leave empty to run in offline / mock mode.
VITE_API_BASE_URL=

# ---------- Feature Flags ----------
VITE_ENABLE_3D=true
VITE_ENABLE_MAP=true
VITE_ENABLE_AI=true
VITE_ENABLE_SIMULATIONS=true
VITE_ENABLE_GAMES=true

# ---------- Public Configuration (safe to expose) ----------
# Default map style URL (public MapLibre style)
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Default map center (lat,lng)
VITE_MAP_DEFAULT_CENTER=15.0,85.0

# Default map zoom
VITE_MAP_DEFAULT_ZOOM=5

# ---------- Optional Third-Party (only if using client-side services) ----------
# Some tile providers permit client-side keys — check their policy first.
# VITE_MAPBOX_TOKEN=
# VITE_MAPTILER_KEY=

# ==============================================================================
# SERVER-SIDE ONLY (never exposed to browser — do not prefix with VITE_)
# ==============================================================================
# The following variables belong in your backend environment, not here.
# Documented for reference:
#
#   DATABASE_URL
#   AIS_PROVIDER_API_KEY
#   COPERNICUS_USER
#   COPERNICUS_PASSWORD
#   NOAA_API_KEY
#   OPENWEATHER_API_KEY
#   OPENAI_API_KEY
#   ANTHROPIC_API_KEY
#   JWT_SECRET
#   SERVICE_ROLE_KEY
#
# ==============================================================================